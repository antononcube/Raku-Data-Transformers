use v6.d;
use Test;

use Data::Transformers;

plan *;

is-deeply
        accumulate([3, 8, 4, 11, 9, 2]),
        [3, 11, 15, 26, 35, 37],
        "array of numbers";

is-deeply
        accumulate([[10, 7], [2, 8], [0, 2], [9, 0], [4, 9], [6, 7]]),
        [[10, 7], [12, 15], [12, 17], [21, 17], [25, 26], [31, 33]],
        "array of pairs of numbers";

done-testing;
