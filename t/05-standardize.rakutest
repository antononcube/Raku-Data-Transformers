use v6.d;
use Test;

use Data::Transformers;

plan *;

# 1
my @data1 = 6.5, 3.8, 6.6, 5.7, 6.0, 6.4, 5.3;

is-deeply
        standardize(@data1),
        [0.8177071028391707e0, -2.1543437132493533e0, 0.9277830589905974e0, -0.06290054637224389e0, 0.2673273220820366e0, 0.7076311466877439e0, -0.5032043709779511e0],
        "array of numbers";
# 2
my @data2 =
        (0.8637835989968501,0.17192798574964918,5.590707942311141),
        (1.6436359322173089,9.208044289706553,7.580587318303631),
        (7.790901372686836,6.402178325008943,5.297628468540436),
        (6.227036959777412,8.365244094379287,2.487780585739483),
        (1.493971517008108,2.530311832691734,6.762706700755445),
        (8.698516940588517,9.892448967987956,6.287542109831017),
        (9.633480911591732,6.911546807473674,8.529954423575141),
        (9.94436182805792,9.630710723339917,9.982522049761391),
        (9.637412184325793,8.952573468448783,7.514783970967624),
        (0.4637152281210688,9.144404361286604,8.688273052826805);

my @res2 = (-1.243340345792906e0, -2.228244293486194e0, -0.6381153754151752e0),
           (-1.0403163574582537e0, 0.6692434641577614e0, 0.35270185362444e0),
           (0.5600409075152453e0, -0.2304751769957474e0, -0.7840479357468997e0),
           (0.1529099972154041e0, 0.3989942590837477e0, -2.1831506787818005e0),
           (-1.079279460078036e0, -1.4720136193250377e0, -0.05454404124801446e0),
           (0.7963263228695496e0, 0.8887021463934291e0, -0.2911419320536634e0),
           (1.0397315244137963e0, -0.06714295633531302e0, 0.82541859009361e0),
           (1.1206651587307623e0, 0.8047741253206131e0, 1.5486930999631687e0),
           (1.040754978003278e0, 0.5873251319749969e0, 0.3199365056060585e0),
           (-1.3474927254188402e0, 0.6488369192117437e0, 0.904249913958276e0);


is-deeply standardize(@data2), @res2, "array of arrays of numbers";

## 3
is-deeply
        standardize(@data1, center => { $_.sum / $_.elems }, scale => {1} ),
        [<26/35>, <-137/70>, <59/70>, <-2/35>, <17/70>, <9/14>, <-16/35>],
        "array of arrays of numbers with callable center and scale";

done-testing;
